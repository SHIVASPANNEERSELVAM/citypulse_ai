# CityPulse AI Backend — Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="CityPulse AI"
DEBUG=true

# Security — CHANGE THIS in production!
SECRET_KEY="citypulse-super-secret-key-change-in-production-2024"

# Database
# Default: SQLite (no setup needed for local development)
DATABASE_URL="sqlite+aiosqlite:///./citypulse.db"
# For PostgreSQL (production):
# DATABASE_URL="postgresql+asyncpg://username:password@localhost:5432/citypulse"

# AI Provider — "auto" uses Gemini if key set, else smart mock
AI_PROVIDER="auto"

# Google Gemini API (optional — mock AI used if not set)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# File Upload
MAX_UPLOAD_SIZE_MB=10
